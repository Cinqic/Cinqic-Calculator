#:kivy 2.2.0
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

# Keypad geometry. 4 columns keeps every key comfortably above the 48dp
# minimum touch target on a narrow phone, and lets "=" sit in the grid with
# the other keys instead of in a detached row of its own.
<CalcButton>:
    font_size: sp(22)

<CalculatorScreen>:
    canvas.before:
        Color:
            rgba: root.background_color
        Rectangle:
            pos: self.pos
            size: self.size

    FloatLayout:
        BoxLayout:
            id: content_layout
            orientation: "vertical"
            padding: dp(12)
            spacing: dp(10)
            size_hint: 1, 1

            # -- Top row: mode + scientific -----------------------------
            BoxLayout:
                size_hint_y: None
                height: dp(44)
                spacing: dp(8)

                CalcButton:
                    text: root.memory_indicator_text
                    kind: "function"
                    font_size: sp(14)
                    size_hint_x: None
                    width: dp(44)
                    opacity: 1 if root.memory_indicator_text else 0
                    disabled: not root.memory_indicator_text
                    reduced_motion: root.reduced_motion
                    on_release: root.open_scientific()

                Widget:

                CalcButton:
                    text: "DEG" if root.degree_mode else "RAD"
                    kind: "function"
                    font_size: sp(14)
                    size_hint_x: None
                    width: dp(70)
                    reduced_motion: root.reduced_motion
                    on_release: root.toggle_degree_mode()

                CalcButton:
                    text: "fx"
                    kind: "accent"
                    font_size: sp(18)
                    size_hint_x: None
                    width: dp(64)
                    active: root.scientific_visible
                    reduced_motion: root.reduced_motion
                    on_release: root.toggle_scientific()

            # -- Display card -------------------------------------------
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: dp(168)
                padding: dp(14), dp(10)
                spacing: dp(2)
                canvas.before:
                    Color:
                        rgba: 0.086, 0.086, 0.086, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(18)]

                Label:
                    id: expression_label
                    text: root.expression_text
                    font_size: sp(16)
                    size_hint_y: None
                    height: dp(26)
                    halign: "right"
                    valign: "middle"
                    shorten: True
                    shorten_from: "left"
                    text_size: self.size
                    color: 0.63, 0.63, 0.63, 1

                Label:
                    id: display_label
                    text: root.display_text
                    font_size: sp(root.display_font_size)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                    color: 1, 1, 1, 1
                    opacity: root.entry_opacity
                    # Cosmetic only: the value is already committed before
                    # this offset animates back to zero. Top padding shrinks
                    # the text box from above, so animating it to 0 makes a
                    # freshly entered value rise into place.
                    padding: (0, root.entry_offset, 0, 0)

                BoxLayout:
                    size_hint_y: None
                    height: dp(34)
                    spacing: dp(8)

                    Label:
                        text: root.preview_text
                        font_size: sp(18)
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        color: root.preview_color

                    CalcButton:
                        text: root.backspace_label
                        kind: "function"
                        # Roboto has no U+232B; the registered symbol font
                        # does, and falls back to a "DEL" label if absent.
                        font_name: root.symbol_font
                        font_size: sp(20)
                        size_hint_x: None
                        width: dp(56)
                        reduced_motion: root.reduced_motion
                        on_release: root.on_button("⌫")

            # -- Keypad --------------------------------------------------
            GridLayout:
                id: keypad
                cols: 4
                spacing: dp(9)

                CalcButton:
                    text: root.clear_label
                    kind: "function"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("clear")
                CalcButton:
                    text: root.paren_key_label
                    kind: "function"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("paren")
                CalcButton:
                    text: "%"
                    kind: "function"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("%")
                CalcButton:
                    text: "÷"
                    kind: "operator"
                    active: root.active_operator == "/"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("÷")

                CalcButton:
                    text: "7"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("7")
                CalcButton:
                    text: "8"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("8")
                CalcButton:
                    text: "9"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("9")
                CalcButton:
                    text: "×"
                    kind: "operator"
                    active: root.active_operator == "*"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("×")

                CalcButton:
                    text: "4"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("4")
                CalcButton:
                    text: "5"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("5")
                CalcButton:
                    text: "6"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("6")
                CalcButton:
                    text: "−"
                    kind: "operator"
                    active: root.active_operator == "-"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("−")

                CalcButton:
                    text: "1"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("1")
                CalcButton:
                    text: "2"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("2")
                CalcButton:
                    text: "3"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("3")
                CalcButton:
                    text: "+"
                    kind: "operator"
                    active: root.active_operator == "+"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("+")

                CalcButton:
                    text: "±"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("±")
                CalcButton:
                    text: "0"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("0")
                CalcButton:
                    text: "."
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button(".")
                CalcButton:
                    text: "="
                    kind: "equals"
                    reduced_motion: root.reduced_motion
                    on_release: root.on_button("=")

        # -- Scientific sheet -------------------------------------------
        # Slides up over the keypad rather than pushing the whole screen
        # into an endless vertical grid. Always openable and closable by
        # tap; the drag handle is an extra, never the only way.
        ScientificSheet:
            id: scientific_sheet
            size_hint: 1, None
            height: root.sheet_height
            pos_hint: {"x": 0}
            y: root.sheet_y
            screen: root
