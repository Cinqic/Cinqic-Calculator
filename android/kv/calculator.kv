#:kivy 2.2.0

<CalculatorScreen>:
    canvas.before:
        Color:
            rgba: root.background_color
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        id: content_layout
        orientation: "vertical"
        padding: "10dp"
        spacing: "8dp"

        BoxLayout:
            size_hint_y: 0.18
            orientation: "vertical"
            Label:
                text: root.memory_indicator_text
                size_hint_y: 0.3
                halign: "right"
                valign: "middle"
                text_size: self.size
                color: 0.7, 0.9, 0.4, 1
            Label:
                id: display_label
                text: root.display_text
                font_size: "40sp"
                halign: "right"
                valign: "middle"
                text_size: self.size
                color: 1, 1, 1, 1

        GridLayout:
            cols: 5
            size_hint_y: 0.12
            spacing: "4dp"
            Button:
                text: "MC"
                disabled: not root.memory_controls_enabled_prop
                on_release: root.on_button("MC")
            Button:
                text: "MR"
                disabled: not root.memory_controls_enabled_prop
                on_release: root.on_button("MR")
            Button:
                text: "M+"
                on_release: root.on_button("M+")
            Button:
                text: "M-"
                on_release: root.on_button("M-")
            Button:
                text: "MS"
                on_release: root.on_button("MS")

        GridLayout:
            cols: 4
            spacing: "4dp"
            size_hint_y: 0.6

            Button:
                text: "C"
                on_release: root.on_button("C")
            Button:
                text: "CE"
                on_release: root.on_button("CE")
            Button:
                text: "%"
                on_release: root.on_button("%")
            Button:
                text: "÷"
                on_release: root.on_button("÷")

            Button:
                text: "7"
                on_release: root.on_button("7")
            Button:
                text: "8"
                on_release: root.on_button("8")
            Button:
                text: "9"
                on_release: root.on_button("9")
            Button:
                text: "×"
                on_release: root.on_button("×")

            Button:
                text: "4"
                on_release: root.on_button("4")
            Button:
                text: "5"
                on_release: root.on_button("5")
            Button:
                text: "6"
                on_release: root.on_button("6")
            Button:
                text: "-"
                on_release: root.on_button("-")

            Button:
                text: "1"
                on_release: root.on_button("1")
            Button:
                text: "2"
                on_release: root.on_button("2")
            Button:
                text: "3"
                on_release: root.on_button("3")
            Button:
                text: "+"
                on_release: root.on_button("+")

            Button:
                text: "+/-"
                on_release: root.on_button("+/-")
            Button:
                text: "0"
                on_release: root.on_button("0")
            Button:
                text: "."
                on_release: root.on_button(".")
            Button:
                text: "⌫"
                on_release: root.on_button("⌫")

        Button:
            text: "="
            size_hint_y: 0.13
            background_color: 0.2, 0.7, 0.2, 1
            on_release: root.on_button("=")

        BoxLayout:
            size_hint_y: 0.08
            Button:
                text: ("Hide Scientific" if root.scientific_visible else "Scientific")
                on_release: root.toggle_scientific()

        BoxLayout:
            id: scientific_panel
            orientation: "vertical"
            size_hint_y: (0.32 if root.scientific_visible else 0)
            opacity: 1 if root.scientific_visible else 0
            disabled: not root.scientific_visible

            GridLayout:
                cols: 6
                spacing: "3dp"
                Button:
                    text: "x²"
                    on_release: root.on_scientific_button("x²")
                Button:
                    text: "x³"
                    on_release: root.on_scientific_button("x³")
                Button:
                    text: "√x"
                    on_release: root.on_scientific_button("√x")
                Button:
                    text: "∛x"
                    on_release: root.on_scientific_button("∛x")
                Button:
                    text: "1/x"
                    on_release: root.on_scientific_button("1/x")
                Button:
                    text: "x!"
                    on_release: root.on_scientific_button("x!")

            GridLayout:
                cols: 6
                spacing: "3dp"
                Button:
                    text: "|x|"
                    on_release: root.on_scientific_button("|x|")
                Button:
                    text: "π"
                    on_release: root.on_scientific_button("pi")
                Button:
                    text: "e"
                    on_release: root.on_scientific_button("e")
                Button:
                    text: "ln"
                    on_release: root.on_scientific_button("ln")
                Button:
                    text: "log"
                    on_release: root.on_scientific_button("log")
                Button:
                    text: ("Deg" if root.degree_mode else "Rad")
                    on_release: root.toggle_degree_mode()

            GridLayout:
                cols: 3
                spacing: "3dp"
                Button:
                    text: "sin"
                    on_release: root.on_scientific_button("sin")
                Button:
                    text: "cos"
                    on_release: root.on_scientific_button("cos")
                Button:
                    text: "tan"
                    on_release: root.on_scientific_button("tan")
