#:kivy 2.2.0

<FinancialScreen>:
    ScrollView:
        id: scroll_view
        BoxLayout:
            orientation: "vertical"
            padding: "16dp"
            spacing: "10dp"
            size_hint_y: None
            height: self.minimum_height

            Label:
                text: "Financial"
                font_size: "22sp"
                size_hint_y: None
                height: "36dp"

            Spinner:
                id: operation_spinner
                text: ""
                values: root.operation_names
                size_hint_y: None
                height: "44dp"
                on_text: root.on_operation_selected(self.text)

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: "44dp" if root.field_visible[0] else 0
                opacity: 1 if root.field_visible[0] else 0
                disabled: not root.field_visible[0]
                Label:
                    text: root.field_labels[0]
                    size_hint_y: None
                    height: "18dp"
                TextInput:
                    id: field1
                    multiline: False
                    input_filter: "float"

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: "44dp" if root.field_visible[1] else 0
                opacity: 1 if root.field_visible[1] else 0
                disabled: not root.field_visible[1]
                Label:
                    text: root.field_labels[1]
                    size_hint_y: None
                    height: "18dp"
                TextInput:
                    id: field2
                    multiline: False
                    input_filter: "float"

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: "44dp" if root.field_visible[2] else 0
                opacity: 1 if root.field_visible[2] else 0
                disabled: not root.field_visible[2]
                Label:
                    text: root.field_labels[2]
                    size_hint_y: None
                    height: "18dp"
                TextInput:
                    id: field3
                    multiline: False
                    input_filter: "float"

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: "44dp" if root.field_visible[3] else 0
                opacity: 1 if root.field_visible[3] else 0
                disabled: not root.field_visible[3]
                Label:
                    text: root.field_labels[3]
                    size_hint_y: None
                    height: "18dp"
                TextInput:
                    id: field4
                    multiline: False
                    input_filter: "float"

            Button:
                text: "Calculate"
                size_hint_y: None
                height: "48dp"
                on_release: root.calculate()

            Label:
                text: root.result_text
                font_size: "26sp"
                size_hint_y: None
                height: "60dp"

            Label:
                text: "Estimates only - not financial, tax, or investment advice."
                font_size: "12sp"
                color: 0.6, 0.6, 0.6, 1
                size_hint_y: None
                height: "32dp"
